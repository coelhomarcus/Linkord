# Copie pra .env e preencha antes de rodar (`npm run dev` ou `docker compose up`).

## Servidor

PORT=3000
HOST_BIND=0.0.0.0
# '1' se estiver atras de um proxy reverso (Dokploy/Traefik, nginx, Cloudflare) —
# necessario pro cookie de sessao e pro IP real chegarem certos. Deixe
# comentado/ausente em dev local sem proxy; a imagem Docker ja liga isso por
# padrao (ver Dockerfile), nao precisa repetir aqui pra rodar via Docker.
# TRUST_PROXY=1
MAX_PARTICIPANTS=50
# tamanho maximo de um grupo — so barra NOVOS aceites de convite; grupos que ja
# passam disso continuam com todos os membros.
MAX_GROUP_MEMBERS=50
# limite do transporte Socket.IO (sinalizacao/chat), nao afeta uploads.
MAX_MSG_BYTES=65536
# janela pra uma conexao cair e voltar sem contar como saida da sala.
RECONNECT_GRACE_MS=30000

## Banco (PostgreSQL)

DATABASE_URL=postgres://usuario:senha@localhost:5432/linkord
# '1' se o Postgres exigir/aceitar TLS.
DATABASE_SSL=0
# Necessario apenas se o certificado do Postgres for autoassinado ou emitido
# por uma CA privada (o Node nao confia nele por padrao). Cole aqui o
# certificado (PEM) a ser confiado, com as quebras de linha escapadas como
# "\n" numa unica linha. NAO existe opcao pra desligar a verificacao do
# certificado — sem isso configurado, a conexao TLS falha em vez de aceitar
# qualquer certificado (o que abriria brecha a man-in-the-middle na conexao
# que carrega credenciais/sessoes).
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# aplica migrations pendentes ao iniciar; use 0 se preferir rodar manualmente.
MIGRATE_ON_BOOT=1

## Contas e sessão

# fechado por padrao (vazio = ninguem consegue se cadastrar) — defina um
# codigo pra habilitar o registro.
REGISTRATION_CODE=
# registrar com esse username vira admin automaticamente (reivindicacao unica).
# OBSOLETO: cadastrar com esse nome nao da mais admin. Use `npm run admin:grant -- <usuario>`.
# ADMIN_USERNAME=
SESSION_COOKIE=ss_session
SESSION_TTL_DAYS=30
# 'auto' le X-Forwarded-Proto (atras de proxy); force '1' ou '0' em dev sem HTTPS.
COOKIE_SECURE=auto

# Recuperação de conta (Resend) — necessário para enviar códigos por e-mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Linkord <noreply@seu-dominio.com>
APP_URL=http://localhost:5173

## LiveKit (voz/vídeo/tela) — https://cloud.livekit.io

LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# prefixo usado para criar uma sala LiveKit por canal de voz.
LIVEKIT_ROOM_NAME=linkord-room
# validade (segundos) do token de entrada na sala; quem ja esta conectado nao e afetado.
LIVEKIT_TOKEN_TTL_SECONDS=300

## Upload de anexos

# pasta onde os arquivos enviados ficam salvos — o padrao ja aponta pra
# <repo>/uploads em dev e /app/uploads em Docker (bate com o volume do
# docker-compose.yml). So defina se quiser outro caminho.
# UPLOAD_DIR=./uploads

# util em dev local quando o DATABASE_URL acima aponta pro MESMO banco de uma
# instancia ja rodando em outro lugar (ex.: a VPS) — os registros de
# attachments existem no banco compartilhado, mas os ARQUIVOS em si so
# existem no disco de quem fez o upload. Com isso definido, um arquivo que
# nao existe aqui e buscado (e cacheado) dessa URL em vez de dar 404. Nunca
# precisa disso na propria instancia que os arquivos vivem.
# UPLOADS_REMOTE_URL=https://sua-instancia.exemplo.com

## Integração com Discord (opcional)

# notifica um canal do Discord quando alguem entra na chamada ou comeca a
# compartilhar tela. Deixe vazio pra desabilitar.
DISCORD_WEBHOOK_URL=
# so posta para ESTA conversa (id do grupo). Vazio = nao posta nada — chamadas
# de DMs e grupos privados nunca vao para o canal.
DISCORD_WEBHOOK_CONVERSATION_ID=

## Limites de abuso e cotas (valores iniciais, ajuste com o uso real)

# REGISTRATIONS_PER_IP_PER_HOUR=5
# MAX_NEW_ACCOUNTS_PER_HOUR=30
# MAX_CONNECTIONS_PER_USER=5
# MAX_USER_STORAGE_BYTES=5368709120
# MAX_OWNED_GROUPS_PER_USER=20
# MAX_GROUP_MEMBERSHIPS_PER_USER=100
# MAX_FRIENDS=500
# MAX_PENDING_OUTGOING_REQUESTS=50
# origens de navegador extras aceitas em POST/PUT/DELETE e no socket (alem do
# APP_URL e do proprio host), separadas por virgula.
# ALLOWED_ORIGINS=

## Limpeza de arquivos orfaos

# o varredor diario so RELATA arquivos sem registro no banco; defina 0 para ele
# tambem apagar (um admin pode rodar uma coleta real em /admin/system).
# ORPHAN_SWEEP_DRY_RUN=1
